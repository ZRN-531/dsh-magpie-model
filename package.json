{
  "name": "dsh-magpie-model",
  "version": "1.0.0",
  "type": "module",
  "description": "Magpie Model — 把 magpie（usemagpie.ai）的本地网关接进 dsh 的模型选择器：插件自己拉起并守护 magpie serve 进程，替纯 Go 的 magpie 补上 Android 缺失的本地 DNS 解析，从网关同步模型清单（含思考档位与上下文窗口），并以 dsh-llm 的 adapter 契约把 OpenAI 兼容流翻译成 harness 事件。无需在 dsh 里填任何 API Key —— 凭据由 magpie 自己的账号渠道持有。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "magpie",
    "llm-provider",
    "gateway"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
