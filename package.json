{
  "name": "dsh-magpie-model",
  "version": "1.5.0",
  "type": "module",
  "description": "Magpie Model — 把 magpie（usemagpie.ai）的本地网关接进 dsh 的模型选择器：插件自己拉起并守护 magpie serve 进程，替纯 Go 的 magpie 补上 Android 缺失的本地 DNS 解析，从网关同步模型清单（含思考档位与上下文窗口），并以 dsh-llm 的 adapter 契约把 OpenAI 兼容流翻译成 harness 事件。无需在 dsh 里填任何 API Key —— 凭据由 magpie 自己的账号渠道持有。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-magpie-doctor": "./scripts/doctor.mjs"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "doctor:check": "node scripts/doctor.mjs --no-live --check",
    "test": "node test/client-lint.mjs && node test/integration.mjs",
    "test:live": "node test/verify-live.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "install.sh",
    "uninstall.sh"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "magpie",
    "llm-provider",
    "gateway"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZRN-531/dsh-magpie-model.git"
  },
  "homepage": "https://github.com/ZRN-531/dsh-magpie-model#readme",
  "bugs": {
    "url": "https://github.com/ZRN-531/dsh-magpie-model/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
